  "flows": [
    {
      "id": "mission-lifecycle",
      "group": "미션",
      "title": "미션 수명주기",
      "summary": "생성 → 슈퍼바이저/오너 배정 → 이슈 트리 → 상태 전이",
      "steps": [
        {
          "from": "ui-missions-page",
          "to": "ui-missions-api",
          "call": "create mission"
        },
        {
          "from": "ui-missions-api",
          "to": "api-missions",
          "call": "POST /companies/:id/missions"
        },
        {
          "from": "api-missions",
          "to": "api-authz",
          "call": "assertCompanyAccess"
        },
        {
          "from": "api-missions",
          "to": "svc-missions",
          "call": "missionService.create"
        },
        {
          "from": "svc-missions",
          "to": "db-client",
          "call": "insert mission + owner agent"
        },
        {
          "from": "ui-mission-detail",
          "to": "ui-missions-api",
          "call": "mission detail + issue tree query"
        },
        {
          "from": "api-missions",
          "to": "svc-missions",
          "call": "getById / getIssueTree"
        },
        {
          "from": "svc-missions",
          "to": "db-schema",
          "call": "select missions/issues/workflow runs"
        }
      ]
    },
    {
      "id": "step-activation",
      "group": "워크플로 엔진",
      "title": "스텝 활성화",
      "summary": "스케줄러 틱 → 런 발파 → 런어블 판정 → 스텝 실행",
      "steps": [
        {
          "from": "eng-scheduler",
          "to": "eng-engine",
          "call": "tick workflowService"
        },
        {
          "from": "eng-engine",
          "to": "eng-dag",
          "call": "activate runnable steps"
        },
        {
          "from": "eng-scheduler",
          "to": "eng-dag",
          "call": "processQueuedWorkflowToolStepRuns"
        },
        {
          "from": "eng-dag",
          "to": "eng-edge-cond",
          "call": "resolveEdges (deps + conditional)"
        },
        {
          "from": "eng-dag",
          "to": "eng-wakeups",
          "call": "runnable step wakeups"
        },
        {
          "from": "eng-reconciler",
          "to": "eng-engine",
          "call": "issue 상태 → 런 상태 동기화 (native-reconciler.reconcileWorkflow)"
        },
        {
          "from": "eng-wakeups",
          "to": "db-schema",
          "call": "step run rows + wakeup requests"
        },
        {
          "from": "eng-store",
          "to": "eng-dag",
          "call": "normalizeWorkflowStepsForExecution(정의 stepsJson)"
        }
      ]
    },
    {
      "id": "if-branch",
      "group": "워크플로 엔진",
      "title": "IF 조건 분기 (컨트롤 노드)",
      "summary": "type:if 스텝 평가 → condition_true/false 경로 활성화, 재개 시 stale 평가 재판정",
      "steps": [
        {
          "from": "eng-dag",
          "to": "eng-control-node",
          "call": "activate type:if step"
        },
        {
          "from": "eng-control-node",
          "to": "eng-cond-eval",
          "call": "evaluate conditionGroup"
        },
        {
          "from": "eng-cond-eval",
          "to": "eng-control-node",
          "call": "outcome: condition_true|condition_false"
        },
        {
          "from": "eng-control-node",
          "to": "eng-edge-cond",
          "call": "branch edge gate"
        },
        {
          "from": "eng-edge-cond",
          "to": "eng-wakeups",
          "state": "cond",
          "stateLabel": "TRUE/FALSE",
          "note": "두 갈래 모두 정상 경로 — outcome 에 따라 해당 분기 스텝만 웨이크업"
        },
        {
          "from": "eng-engine",
          "to": "eng-control-node",
          "call": "resume 시 resetStaleIfControlNodesForResume (stale IF 재판정)"
        }
      ]
    },
    {
      "id": "qa-rework-loop",
      "group": "워크플로 엔진",
      "title": "QA 재작업 루프",
      "summary": "QA 반려 → back-edge 재발화 → 생산자 리셋 → 상한 도달 시 cap-acceptance",
      "steps": [
        {
          "from": "eng-engine",
          "to": "eng-loop-driver",
          "call": "applyBackEdgeReworkPass"
        },
        {
          "from": "eng-loop-driver",
          "to": "eng-edge-cond",
          "call": "qa_request_changes back-edge gate"
        },
        {
          "from": "eng-loop-driver",
          "to": "eng-step-reset",
          "call": "reset producer step"
        },
        {
          "from": "eng-step-reset",
          "to": "eng-wakeups",
          "call": "re-dispatch rework"
        },
        {
          "from": "eng-loop-driver",
          "to": "eng-qa-cap",
          "call": "maxIterations 도달"
        },
        {
          "from": "eng-qa-cap",
          "to": "eng-verdict-ledger",
          "call": "cap-acceptance verdict 기록"
        },
        {
          "from": "ui-dag-panel",
          "to": "ui-missions-api",
          "call": "grantQaReworkCapBoost (운영자 상한 부스트)"
        }
      ]
    },
    {
      "id": "heartbeat-lifecycle",
      "group": "런타임·감독",
      "title": "하트비트 생명주기",
      "summary": "런타임 bootstrap → 하트비트 이벤트 → 타임아웃/고아 회수(reaper)",
      "steps": [
        {
          "from": "svc-missions",
          "to": "svc-runtime-manager",
          "call": "bootstrap mission CLI runtime"
        },
        {
          "from": "svc-runtime-manager",
          "to": "rt-adapters",
          "call": "spawn agent CLI process"
        },
        {
          "from": "rt-adapters",
          "to": "svc-heartbeat",
          "call": "heartbeat run events"
        },
        {
          "from": "svc-heartbeat-scheduler",
          "to": "svc-heartbeat",
          "call": "timer/routine/recovery 틱"
        },
        {
          "from": "svc-heartbeat",
          "to": "svc-runtime-manager",
          "call": "reap orphaned/stale-busy runtimes"
        },
        {
          "from": "svc-heartbeat",
          "to": "db-schema",
          "call": "heartbeat runs + events persist"
        }
      ]
    },
    {
      "id": "mission-supervision",
      "group": "런타임·감독",
      "title": "미션 감독 루프",
      "summary": "stale 탐지 → 소유자 결정 파싱 → 조치(재시도/언블록/에스컬레이션)",
      "steps": [
        {
          "from": "svc-heartbeat",
          "to": "svc-supervision",
          "call": "stale/timeout 단서 전달"
        },
        {
          "from": "svc-supervision",
          "to": "svc-supervision",
          "call": "runMainExecutorSupervision (findings 정규화)"
        },
        {
          "from": "svc-supervision",
          "to": "svc-missions",
          "call": "소유자 결정 → unblock/oversight 이슈 생성"
        },
        {
          "from": "svc-missions",
          "to": "db-client",
          "call": "insert oversight issues"
        },
        {
          "from": "svc-supervision",
          "to": "svc-heartbeat",
          "call": "owner action 시 agent wakeup"
        }
      ]
    },
    {
      "id": "agent-dispatch",
      "group": "런타임·감독",
      "title": "에이전트 배차·산출물 검증",
      "summary": "스텝 이슈 배차 → CLI 실행 → 산출물 전달 검증 → 완료 게이트",
      "steps": [
        {
          "from": "eng-wakeups",
          "to": "rt-adapters",
          "call": "assign + dispatch step issue"
        },
        {
          "from": "rt-adapters",
          "to": "db-schema",
          "call": "이슈 코멘트·실행 결과 기록"
        },
        {
          "from": "eng-dag",
          "to": "rt-delivery-gate",
          "call": "산출물 전달 검증 (readback)"
        },
        {
          "from": "rt-delivery-gate",
          "to": "db-schema",
          "call": "registered artifacts"
        }
      ]
    },
    {
      "id": "tool-execution",
      "group": "런타임·감독",
      "title": "도구 실행",
      "summary": "도구 참조 검증 → 코어/원격 실행 → 결과 진실 기록 → IF 소스 환류",
      "steps": [
        {
          "from": "eng-engine",
          "to": "rt-tool-catalog",
          "call": "assertWorkflowToolReferencesSelectable"
        },
        {
          "from": "eng-engine",
          "to": "rt-core-tools",
          "call": "execute workflow tool step"
        },
        {
          "from": "rt-core-tools",
          "to": "rt-remote-tools",
          "call": "원격 도구 라우팅"
        },
        {
          "from": "rt-core-tools",
          "to": "rt-tool-truth",
          "call": "도구 결과 진실 기록"
        },
        {
          "from": "eng-cond-eval",
          "to": "rt-tool-truth",
          "call": "IF tool_json 소스 읽기 (반대류 데이터 환류)",
          "note": "tool_json 조건은 에이전트 텍스트가 아니라 이 진실 기록만 근거로 쓴다"
        }
      ]
    },
    {
      "id": "mission-board-view",
      "group": "보드 UI",
      "title": "미션 실행흐름 화면·flowmap 내보내기",
      "summary": "Execution Flow 그래프(IF 분기 표현) + 단일 HTML 흐름도 내보내기",
      "steps": [
        {
          "from": "ui-mission-detail",
          "to": "ui-dag-panel",
          "call": "Execution Flow 탭"
        },
        {
          "from": "ui-dag-panel",
          "to": "ui-missions-api",
          "call": "listWorkflowRuns"
        },
        {
          "from": "ui-missions-api",
          "to": "api-missions",
          "call": "GET /missions/:id/workflow-runs"
        },
        {
          "from": "api-missions",
          "to": "svc-missions",
          "call": "listWorkflowRuns"
        },
        {
          "from": "svc-missions",
          "to": "svc-workflow-progress",
          "call": "steps 정규화 + progress 집계"
        },
        {
          "from": "svc-workflow-progress",
